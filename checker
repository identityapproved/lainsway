#!/usr/bin/env bash
set -euo pipefail

tools=(
  hyprctl
  hyprland
  waybar
  mako
  swaylock
  wlogout
  wofi
  wpaperd
  kitty
  alacritty
  fish
  tmux
  lazygit
  lsd
  bat
  rg
  fzf
  git
  nvim
  mpv
  pavucontrol
  yazi
  sioyek
  task
  trans
)

for tool in "${tools[@]}"; do
  if command -v "$tool" >/dev/null 2>&1; then
    printf '%-16s %s\n' "$tool" "ok"
  else
    printf '%-16s %s\n' "$tool" "missing"
  fi
done
