#!/usr/bin/env bash
set -euo pipefail

tools=(
  sway
  swaymsg
  swaybg
  swayidle
  swaynag
  swaync
  tofi
  foot
  grim
  slurp
  swappy
  wl-copy
  wpctl
  brightnessctl
  zsh
  tmux
  nvim
  yazi
  ya
  dcraw
  exiftool
  magick
  lazygit
  firefox
  delta
  mpv
  zathura
  mpd
  playerctl
  mpDris2
  rmpc
  pavucontrol
  fastfetch
  bat
  eza
  rg
  fzf
  git
)

for tool in "${tools[@]}"; do
  if command -v "$tool" >/dev/null 2>&1; then
    printf '%-16s %s\n' "$tool" "ok"
  else
    printf '%-16s %s\n' "$tool" "missing"
  fi
done

