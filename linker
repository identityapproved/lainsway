#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_config="$script_dir/.config"

if [ ! -d "$repo_config" ]; then
  echo "missing $repo_config" >&2
  exit 1
fi

timestamp=$(date +%Y%m%d%H%M%S)

backup_path() {
  local target=$1

  if [ -e "$target" ] || [ -L "$target" ]; then
    mv "$target" "${target}.bak-$timestamp"
  fi
}

link_path() {
  local src=$1
  local dest=$2
  local current_link

  if [ -L "$dest" ]; then
    current_link=$(readlink "$dest" || true)
    if [ "$current_link" = "$src" ]; then
      return 0
    fi
  fi

  if [ -e "$dest" ] || [ -L "$dest" ]; then
    backup_path "$dest"
  fi

  ln -s "$src" "$dest"
}

mkdir -p "$HOME/.config"

prompt_yes_no() {
  local prompt=$1
  local response

  while true; do
    read -r -p "$prompt [y/n]: " response
    case "$response" in
      y|Y)
        return 0
        ;;
      n|N)
        return 1
        ;;
      *)
        echo "Please answer y or n."
        ;;
    esac
  done
}

# Directories that must NOT be whole-dir symlinked: the app writes runtime
# state next to its config, and that state does not belong in this repo.
# These are linked file-by-file instead, below.
file_link_only=(
  offpunk
)

is_file_link_only() {
  local name=$1 candidate
  for candidate in "${file_link_only[@]}"; do
    [ "$candidate" = "$name" ] && return 0
  done
  return 1
}

# Tracked as reference but deliberately never linked on this host:
#   audacious, fish, vesktop - kept per request; shell is zsh, player is rmpc
#   swww                     - transitional dummy package on Void
#   environment.d            - systemd-only, nothing reads it on this host
#   waybar                   - parked; if wanted it gets reinstalled and rewritten
#   eww                      - unported, hardcodes the old monitor name C27R50x
never_link=(
  audacious
  fish
  vesktop
  swww
  environment.d
  waybar
  eww
)

is_never_link() {
  local name=$1 candidate
  for candidate in "${never_link[@]}"; do
    [ "$candidate" = "$name" ] && return 0
  done
  return 1
}

echo "Select configs to link from $repo_config:"
for entry in "$repo_config"/*; do
  entry_name=$(basename "$entry")
  is_file_link_only "$entry_name" && continue
  if is_never_link "$entry_name"; then
    echo "skip $entry_name (tracked as reference, not linked)"
    continue
  fi
  dest="$HOME/.config/$entry_name"
  if prompt_yes_no "Link $entry -> $dest?"; then
    link_path "$entry" "$dest"
  else
    echo "skip $entry_name"
  fi
done

# offpunk keeps cert_cache/ beside offpunkrc, so only the rc file is linked.
echo "Select per-file configs to link:"
for dir_name in "${file_link_only[@]}"; do
  dir_src="$repo_config/$dir_name"
  [ -d "$dir_src" ] || continue
  for src in "$dir_src"/*; do
    [ -e "$src" ] || continue
    dest="$HOME/.config/$dir_name/$(basename "$src")"
    if prompt_yes_no "Link $src -> $dest?"; then
      mkdir -p "$HOME/.config/$dir_name"
      link_path "$src" "$dest"
    else
      echo "skip $dir_name/$(basename "$src")"
    fi
  done
done

dotfiles=(
  .profile
  .zprofile
  .zshrc
  .zshenv
  .dircolors
)

echo "Select dotfiles to link into $HOME:"
for dotfile in "${dotfiles[@]}"; do
  src="$script_dir/$dotfile"
  dest="$HOME/$dotfile"
  if [ -e "$src" ]; then
    if prompt_yes_no "Link $src -> $dest?"; then
      link_path "$src" "$dest"
    else
      echo "skip $dotfile"
    fi
  fi
done

# Helper scripts that are not tied to the compositor. They live here rather
# than in .config so they can be linked straight onto $PATH.
repo_scripts="$script_dir/scripts"

if [ -d "$repo_scripts" ]; then
  echo "Select scripts to link into $HOME/.local/bin:"
  mkdir -p "$HOME/.local/bin"
  for src in "$repo_scripts"/*; do
    [ -f "$src" ] || continue
    dest="$HOME/.local/bin/$(basename "$src")"
    if prompt_yes_no "Link $src -> $dest?"; then
      link_path "$src" "$dest"
    else
      echo "skip $(basename "$src")"
    fi
  done
fi
