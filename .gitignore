*.bak-*
.cache/

# TPM is pinned to ~/.tmux/plugins, but guard against it landing here anyway
.config/tmux/plugins/

# lain flavor is a dev symlink to ~/github/lain.yazi (absolute path, host-specific)
.config/yazi/flavors/

# offpunk writes its TOFU cert store beside offpunkrc
.config/offpunk/cert_cache/

# btop regenerates its bundled themes and writes a log beside its conf
.config/btop/themes/*
!.config/btop/themes/lain.theme
.config/btop/btop.log

# canonical palette lives in the private repo and is symlinked in
lain-colors.md
